PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
MAX_AUDIO_MB=30
# 끝말잇기: 국립국어원 Open API 키(끝말잇기 한방단어 검색기와 같은 키)
STDICT_API_KEY=표준국어대사전_API_키
OPENDICT_API_KEY=우리말샘_API_키
# 끝말잇기 한방 단어장·성장 컴퓨터 기억 노트를 GitHub Gist에도 보관(Render 무료 서버용, 내 컴퓨터에서는 비워 둬도 됨)
# GIST_TOKEN=Gists_읽기쓰기_권한만_있는_토큰
# GIST_ID=비공개_Gist_ID
# MUSIC_DB_PATH=/absolute/path/to/persistent/music-game.db
# MUSIC_UPLOAD_DIR=/absolute/path/to/persistent/uploads
